# Public-safe local placeholder configuration for job-runner-platform.
# Copy values into your shell environment for local experimentation.

JOB_RUNNER_APP_NAME=job-runner-platform
JOB_RUNNER_APP_VERSION=0.1.0
JOB_RUNNER_ENVIRONMENT=local
JOB_RUNNER_LOG_LEVEL=INFO
JOB_RUNNER_DOCS_ENABLED=false
JOB_RUNNER_AUTH_ENABLED=false
JOB_RUNNER_AUTH_API_KEYS=
JOB_RUNNER_DATABASE_URL=postgresql+asyncpg://localhost:5432/job_runner
JOB_RUNNER_REDIS_URL=redis://localhost:6379/0
JOB_RUNNER_WORKER_ID=local-worker-1
JOB_RUNNER_JOB_LEASE_SECONDS=60
JOB_RUNNER_JOB_POLL_SECONDS=1
JOB_RUNNER_MAX_ATTEMPTS=3
